<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily publish of the public dashboard. NOT ENABLED: this file only sits in the repo.

  Enable:
    cp launchd/com.pet9.publish-dashboard.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.pet9.publish-dashboard.plist

  Disable:
    launchctl unload ~/Library/LaunchAgents/com.pet9.publish-dashboard.plist
    rm ~/Library/LaunchAgents/com.pet9.publish-dashboard.plist

  Test once without waiting for the schedule:
    launchctl start com.pet9.publish-dashboard
  Log: ~/Library/Logs/pet9-publish.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pet9.publish-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/olegbolsunov/Projects/MatchJobAIExt9/publish.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/olegbolsunov/Library/Logs/pet9-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/olegbolsunov/Library/Logs/pet9-publish.log</string>
</dict>
</plist>
